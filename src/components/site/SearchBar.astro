<form class="site-search" action={`${import.meta.env.BASE_URL}blog`} method="get" role="search">
  <button class="search-toggle" type="button" aria-label="Apri la ricerca" aria-expanded="false">
    <svg class="search-icon" aria-hidden="true" viewBox="0 0 24 24" focusable="false">
      <circle cx="10.8" cy="10.8" r="6.5"></circle>
      <path d="m16 16 4.5 4.5"></path>
    </svg>
    <svg class="close-icon" aria-hidden="true" viewBox="0 0 24 24" focusable="false">
      <path d="m6 6 12 12M18 6 6 18"></path>
    </svg>
  </button>
  <label class="sr-only" for="site-search-input">Cerca nel blog</label>
  <input
    id="site-search-input"
    name="q"
    type="search"
    placeholder="Cerca nel blog"
    autocomplete="off"
    spellcheck="false"
  />
  <button class="search-submit" type="submit">Cerca</button>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('.site-search').forEach((search) => {
    const header = search.closest<HTMLElement>('#site-header');
    const toggle = search.querySelector<HTMLButtonElement>('.search-toggle');
    const input = search.querySelector<HTMLInputElement>('input');

    if (!header || !toggle || !input) return;

    toggle.addEventListener('click', () => {
      const isOpen = search.classList.toggle('is-open');
      header.classList.toggle('search-is-open', isOpen);
      toggle.setAttribute('aria-expanded', String(isOpen));
      toggle.setAttribute('aria-label', isOpen ? 'Chiudi la ricerca' : 'Apri la ricerca');

      if (isOpen) input.focus();
    });

    input.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;

      search.classList.remove('is-open');
      header.classList.remove('search-is-open');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Apri la ricerca');
      toggle.focus();
    });
  });
</script>