---
import brandImage from '../../assets/download.jpeg';

---

<footer>
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <a class="brand" href="/">
        <img
        class="brand-mark"
        alt=""
        src={brandImage.src}
      />
        <span class="brand-word">Dentisti <b>in Progress</b></span>
      </a>
      <p>La community italiana per il settore dentale</p>
    </div>

    
  </div>

  <div class="wrap footer-bottom">
    <span>© {new Date().getFullYear()} Dentisti in Progress</span>
    <span>Costruito per crescere insieme</span>
  </div>
</footer>
